# SXM Campaigns website. Works on Railway, Render, Fly.io or any Docker host.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-campaigns.txt .
RUN pip install --no-cache-dir -r requirements-campaigns.txt
COPY sxm_campaigns ./sxm_campaigns
COPY sxm/static ./sxm/static
ENV DATA_DIR=/data PORT=8800
VOLUME /data
EXPOSE 8800
CMD ["python", "-m", "sxm_campaigns"]
