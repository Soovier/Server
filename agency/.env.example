# Copy to .env (never commit .env). The CLI reads these from the environment.
ELEVENLABS_API_KEY=
GOOGLE_PLACES_API_KEY=
# Voice for receptionists. Pick one from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# Your agency details (used in proposals; required by CAN-SPAM in outreach emails)
AGENCY_NAME=
AGENCY_OWNER_NAME=
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_MAILING_ADDRESS=
AGENCY_BOOKING_URL=

# Pricing shown on proposals (USD)
PRICE_SETUP=997
PRICE_MONTHLY=497
