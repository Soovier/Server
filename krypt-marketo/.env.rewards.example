# Krypt Rewards website settings. On a host (Render/Railway) set these as environment variables.
SITE_NAME=Krypt Rewards
# Public address of the site, e.g. https://rewards.kryptmarketo.com
BASE_URL=http://localhost:8800
# Long random string. Changing it logs everyone out.
SECRET_KEY=
# The account that signs up with this email becomes the admin (you)
ADMIN_EMAIL=
# Your cut of every campaign funding, in percent
PLATFORM_FEE_PERCENT=10
MIN_PAYOUT_USD=10
SUBMIT_WINDOW_HOURS=24
DATA_DIR=

# Free key for automatic YouTube view checks (Google Cloud > Credentials > API key)
YOUTUBE_API_KEY=
# Optional: verify Instagram bios automatically (your IG business account id + a long-lived token)
META_IG_USER_ID=
META_ACCESS_TOKEN=
VIEWS_REFRESH_MINUTES=60

# Optional: card payments from brands + bank payouts to clippers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
