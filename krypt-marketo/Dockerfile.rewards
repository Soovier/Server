# Krypt Rewards website. Works on Railway, Render, Fly.io or any Docker host.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-rewards.txt .
RUN pip install --no-cache-dir -r requirements-rewards.txt
COPY rewards ./rewards
COPY krypt/static ./krypt/static
ENV DATA_DIR=/data PORT=8800
VOLUME /data
EXPOSE 8800
CMD ["python", "-m", "rewards"]
