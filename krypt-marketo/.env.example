# Krypt Marketo settings. Copy to .env and fill in. Never commit .env.
# See SETUP.md for where each value comes from.

# ---- App ----
KRYPT_BASE_URL=http://localhost:8787
KRYPT_TIMEZONE=America/New_York
# Optional: require a password to open the dashboard
KRYPT_DASHBOARD_PASSWORD=
# Any long random string (used to sign the login cookie)
KRYPT_SESSION_SECRET=
# Where videos and the database live (default: ./data)
KRYPT_DATA_DIR=

# ---- Posting schedule ----
# Local times to post each day (one clip per platform per slot)
POST_SLOTS=11:00,15:00,19:00,21:30
# Cron (minute hour day month weekday) for find + clip runs, and analytics refresh
DISCOVER_CRON=0 */3 * * *
ANALYTICS_CRON=30 */6 * * *

# ---- Meta: Instagram + Facebook Page (developers.facebook.com) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# ---- Google: YouTube Data API + YouTube Analytics API (console.cloud.google.com) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Twitch discovery (dev.twitch.tv/console) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch logins to watch, comma-separated
TWITCH_STREAMERS=
# YouTube channel ids (UC...) whose long videos to clip, comma-separated
YOUTUBE_SOURCE_CHANNEL_IDS=

# ---- Clipping ----
# Whisper model for captions: tiny | base | small | medium | large-v3 (bigger = better, slower)
WHISPER_MODEL=small
CLIPS_PER_SOURCE=3
# Small watermark on every clip, e.g. @kryptmarketo (blank = none)
BRAND_HANDLE=
# blur = full frame over blurred background (gameplay); crop = center crop (talking/IRL)
REFRAME_MODE=blur
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=59
# Optional: Claude picks the best moments and writes hooks/captions (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Alerts ----
# Discord webhook URL or an ntfy.sh topic URL (e.g. https://ntfy.sh/krypt-<random>)
NOTIFY_WEBHOOK_URL=
